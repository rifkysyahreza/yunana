HELIUS_API_KEY=your_helius_api_key
SCAN_INTERVAL_MS=15000

# Comma-separated Solana addresses to monitor for fresh signatures.
# Examples:
# - Pump.fun migration / bonding watcher(s)
# - BONK.fun LaunchLab watcher: RAYpQbFNq9i3mu6cKpTKKRwwHFDeK5AuZz8xvxUrCgw
# - Meteora Curve migration watcher: CQdrEsYAxRqkwmpycuTwnMKggr3cr9fqY8Qma4J9TudY
WATCH_ADDRESSES=

# Optional comma-separated programs to boost detection confidence.
# You can combine Pump + BONK + Meteora Curve program ids here.
# BONK.fun LaunchLab migration program:
# LanMV9sAd7wArD4vJFi2qDdfnVhFxYSUg6eADduJ3uj
# Meteora Curve migration program:
# dbcij3LWUppWqq96dh6gJWwBifmcGfLSB5D4DuSMaqN
WATCH_PROGRAM_IDS=

# Ratio gate:
# sol_per_10k_mc = (total_fee * 10000) / market_cap
# Keep token only if MIN_SOL_PER_10K_MC <= sol_per_10k_mc <= MAX_SOL_PER_10K_MC
MIN_SOL_PER_10K_MC=0.8
MAX_SOL_PER_10K_MC=1
MIN_TWO_CANDLE_AVG_VOLUME=18000
MAX_TOP10_HOLDER_RATE=0.28
MAX_CREATOR_HOLD_RATE=0.07
MAX_BUNDLER_RATE=0.45
MAX_RAT_TRADER_RATIO=0.08
MAX_TOP_BUYER_SOLD_RATIO=0.9
MAX_BUY_TAX=0
MAX_SELL_TAX=0
STRONG_SCORE_THRESHOLD=72
TRADEABLE_SCORE_THRESHOLD=38
WATCH_SCORE_THRESHOLD=22
HIGH_RISK_SCORE_THRESHOLD=8
DEBUG_CANDLE_SELECTION=true
PIPELINE_SUMMARY_EVERY_TICKS=20
FORWARD_ALL_MIGRATED=false
GMGN_RETRY_COUNT=5
GMGN_RETRY_DELAY_MS=2500
ENABLE_GMGN_TRENDING=false
GMGN_TRENDING_INTERVAL_MS=60000

# LP wallet tracker: comma-separated entries in label:wallet format.
# Example:
# ENABLE_LP_WALLET_TRACKER=true
# LP_WALLET_TRACKER_INTERVAL_MS=60000
# LP_WALLET_ENRICHMENT_RETRY_COUNT=3
# LP_WALLET_ENRICHMENT_RETRY_DELAY_MS=5000
# Preferred: tracked-lp-wallets.json file (auto-loaded from repo root)
# Optional override path:
# LP_TRACKED_WALLETS_FILE=./tracked-lp-wallets.json
# Legacy env fallback:
# LP_TRACKED_WALLETS=whale_a:WalletAddress1,whale_b:WalletAddress2
ENABLE_LP_WALLET_TRACKER=false
LP_WALLET_TRACKER_INTERVAL_MS=60000
LP_WALLET_ENRICHMENT_RETRY_COUNT=3
LP_WALLET_ENRICHMENT_RETRY_DELAY_MS=5000
LP_WALLET_SHARD_COUNT=1
METEORA_POOL_META_CACHE_TTL_MS=3600000
LP_TRACKED_WALLETS_FILE=./tracked-lp-wallets.json
LP_TRACKED_WALLETS=
GMGN_QUOTE_WALLET=HVHAvzNxQUhvTWr5uoNNNfrQYfzcsReUFM4HnZwfeHkQ
OUTCOME_HORIZONS_MINUTES=5,15,60
OUTCOME_POLL_INTERVAL_MS=60000

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
# Optional Telegram forum topic IDs inside the same supergroup chat.
# Example:
# TELEGRAM_CHAT_ID=-1003855852720
# TELEGRAM_MIGRATION_THREAD_ID=412
# TELEGRAM_TRENDING_THREAD_ID=414
# TELEGRAM_LP_WALLET_THREAD_ID=415
TELEGRAM_MIGRATION_THREAD_ID=
TELEGRAM_TRENDING_THREAD_ID=
TELEGRAM_LP_WALLET_THREAD_ID=
